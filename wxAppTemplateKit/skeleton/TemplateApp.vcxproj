  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Build number, git commit and build date -> include\GeneratedBuildInfo.h (gitignored), before
       every compile. BuildCounter.txt (gitignored) keeps the count on the building PC. -->
  <Target Name="IncrementBuildNumber" BeforeTargets="ClCompile">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\BuildCounter.txt" Condition="Exists('$(MSBuildProjectDirectory)\BuildCounter.txt')">
      <Output TaskParameter="Lines" ItemName="_BuildNumberLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_OldBuildNumber>@(_BuildNumberLines)</_OldBuildNumber>
      <_OldBuildNumber>$([System.String]::Copy('$(_OldBuildNumber)').Trim())</_OldBuildNumber>
      <_OldBuildNumber Condition="'$(_OldBuildNumber)' == ''">0</_OldBuildNumber>
      <BuildNumber>$([MSBuild]::Add($(_OldBuildNumber), 1))</BuildNumber>
      <BuildDate>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm'))</BuildDate>
    </PropertyGroup>
    <Exec Command="git describe --always --dirty --abbrev=7" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDescribeRaw" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>
    <PropertyGroup>
      <GitDescribe Condition="'$(_GitExitCode)' == '0'">$([System.String]::Copy('$(_GitDescribeRaw)').Trim())</GitDescribe>
      <GitDescribe Condition="'$(GitDescribe)' == ''">unknown</GitDescribe>
    </PropertyGroup>
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\BuildCounter.txt" Lines="$(BuildNumber)" Overwrite="true" />
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\include\GeneratedBuildInfo.h" Lines="#pragma once&#xD;&#xA;constexpr int BUILD_NUMBER = $(BuildNumber)%3b&#xD;&#xA;constexpr const char* GIT_DESCRIBE = &quot;$(GitDescribe)&quot;%3b&#xD;&#xA;constexpr const char* BUILD_DATE = &quot;$(BuildDate)&quot;%3b" Overwrite="true" />
  </Target>
  <!-- Versioned copy of the exe, named like the window title: "Template App v0.1.0-rc.1b12.exe"
       (+ "D" for Debug) - same text as GetCompactVersion(). Previous copies are kept. -->
  <Target Name="CopyVersionedExe" AfterTargets="Build" Condition="'$(BuildNumber)' != ''">
    <PropertyGroup>
      <_VerH>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\include\Version.h'))</_VerH>
      <_VerMajor>$([System.Text.RegularExpressions.Regex]::Replace($(_VerH), '(?s)^.*#define\s+APP_VERSION_MAJOR\s+(\d+).*$', '$1'))</_VerMajor>
      <_VerMinor>$([System.Text.RegularExpressions.Regex]::Replace($(_VerH), '(?s)^.*#define\s+APP_VERSION_MINOR\s+(\d+).*$', '$1'))</_VerMinor>
      <_VerPatch>$([System.Text.RegularExpressions.Regex]::Replace($(_VerH), '(?s)^.*#define\s+APP_VERSION_PATCH\s+(\d+).*$', '$1'))</_VerPatch>
      <_VerPre>$([System.Text.RegularExpressions.Regex]::Replace($(_VerH), '(?s)^.*#define\s+APP_VERSION_PRERELEASE\s+"([^"]*)".*$', '$1'))</_VerPre>
      <_CompactVersion>v$(_VerMajor).$(_VerMinor).$(_VerPatch)</_CompactVersion>
      <_CompactVersion Condition="'$(_VerPre)' != ''">$(_CompactVersion)-$(_VerPre)</_CompactVersion>
      <_CompactVersion>$(_CompactVersion)b$(BuildNumber)</_CompactVersion>
      <_CompactVersion Condition="$(Configuration.StartsWith('Debug'))">$(_CompactVersion)D</_CompactVersion>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(OutDir)$(AppExeBaseName) $(_CompactVersion)$(TargetExt)" />
    <Message Importance="high" Text="Versioned exe: $(OutDir)$(AppExeBaseName) $(_CompactVersion)$(TargetExt)" />
  </Target>
